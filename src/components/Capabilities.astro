---
/**
 * "What I do" — not a skills list.
 *
 * Each capability is a ruled editorial row that carries its own proof
 * links. The rule the whole section exists to satisfy: don't tell me
 * you're good at something, show me where you used it.
 */
import { capabilities } from '@data/capabilities';
import { url } from '@lib/url';
---

<ol class="caps">
  {
    capabilities.map((c) => (
      <li class="cap" data-accent={c.accent} data-reveal data-reveal-group="caps">
        <div class="cap__head">
          <span class="cap__num">{c.num}</span>
          <h3 class="cap__title">{c.title}</h3>
        </div>

        <div class="cap__body">
          <p class="cap__line">{c.line}</p>
          <ul class="cap__items">
            {c.items.map((i) => (
              <li>{i}</li>
            ))}
          </ul>
        </div>

        <div class="cap__proof">
          <p class="label cap__proof-label">Where I used it</p>
          <ul>
            {c.proof.map((p) => (
              <li>
                <a class="link" href={url(p.href)}>
                  {p.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .caps {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--line-thick) solid var(--fg);
  }

  .cap {
    display: grid;
    gap: var(--sp-4);
    padding-block: var(--sp-6);
    border-bottom: var(--line) solid var(--rule);
    position: relative;
  }

  /* A thin accent tick at the left edge — the only decoration. */
  .cap::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--sp-4));
    top: var(--sp-6);
    width: var(--line-heavy);
    height: 2.25rem;
    background: var(--cap-accent, var(--c-pink));
  }

  .cap[data-accent='pink'] {
    --cap-accent: var(--c-pink);
  }
  .cap[data-accent='yellow'] {
    --cap-accent: var(--c-yellow);
  }
  .cap[data-accent='cyan'] {
    --cap-accent: var(--c-cyan);
  }
  .cap[data-accent='lime'] {
    --cap-accent: var(--c-lime);
  }
  .cap[data-accent='ink'] {
    --cap-accent: var(--c-ink);
  }

  .cap__head {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
  }

  .cap__num {
    font-family: var(--ff-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.1em;
    color: var(--fg-mute);
  }

  .cap__title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.05;
  }

  .cap__line {
    color: var(--fg-soft);
    max-width: 42ch;
  }

  .cap__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--sp-3);
    margin-top: var(--sp-3);
    padding: 0;
    list-style: none;
    font-family: var(--ff-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-mute);
  }

  .cap__items li + li::before {
    content: '/';
    margin-right: var(--sp-3);
    color: var(--cap-accent);
  }

  .cap__proof ul {
    display: grid;
    gap: var(--sp-1);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--fs-small);
  }

  .cap__proof-label {
    margin-bottom: var(--sp-2);
  }

  @media (min-width: 48rem) {
    .cap {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: var(--grid-gap);
      align-items: start;
    }

    .cap__head {
      grid-column: 1 / -1;
    }

    .cap::before {
      left: calc(-1 * var(--sp-5));
    }
  }
</style>
