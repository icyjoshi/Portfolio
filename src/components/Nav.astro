---
/**
 * Site header.
 *
 * Deliberately calm: no scroll-triggered shrinking, no animated logo.
 * It sticks, it marks the current page, and it keeps the "Work with
 * me" CTA reachable from everywhere. That's the whole job.
 */
import { site, nav, navCta } from '@data/site';
import { url, isActive } from '@lib/url';

const path = Astro.url.pathname;
---

<header class="nav" id="site-nav">
  <div class="wrap nav__inner">
    <a class="nav__brand" href={url('/')}>
      <span class="nav__name">{site.name}</span>
      <span class="nav__role">{site.role}</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      <ul class="nav__list">
        {
          nav.map((item) => (
            <li>
              <a
                class="nav__link link-wipe"
                href={url(item.href)}
                aria-current={isActive(path, url(item.href)) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="nav__cta" href={url(navCta.href)}>{navCta.label}</a>
    </nav>

    <button
      class="nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-panel"
      data-nav-toggle
    >
      <span class="visually-hidden">Menu</span>
      <span class="nav__bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <!-- Mobile panel -->
  <div class="nav__panel" id="nav-panel" hidden data-nav-panel>
    <nav aria-label="Primary, mobile">
      <ul class="nav__panel-list">
        {
          nav.map((item) => (
            <li>
              <a
                href={url(item.href)}
                aria-current={isActive(path, url(item.href)) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={url(navCta.href)} class="nav__panel-cta">
            {navCta.label}
          </a>
        </li>
      </ul>
    </nav>
    <p class="nav__panel-note label">{site.availability}</p>
  </div>
</header>

<script>
  /* Mobile menu. ~20 lines of vanilla JS beats any dependency here. */
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-nav-panel]');

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      document.documentElement.classList.toggle('nav-open', open);
      if (open) panel.querySelector('a')?.focus();
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    /* Escape closes and returns focus to the button, so keyboard users
       are never stranded inside the panel. */
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    /* Close if the viewport grows past the breakpoint while open. */
    const desktop = window.matchMedia('(min-width: 56rem)');
    desktop.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--c-paper);
    border-bottom: var(--line) solid var(--c-rule);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    min-height: var(--nav-h);
    padding-block: var(--sp-3);
  }

  /* ---- Brand ---- */
  .nav__brand {
    display: flex;
    flex-direction: column;
    gap: 1px;
    text-decoration: none;
    color: var(--c-ink);
    line-height: 1.1;
  }

  .nav__name {
    font-family: var(--ff-display);
    font-variation-settings: var(--wonk-on);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .nav__role {
    font-family: var(--ff-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-ink-mute);
  }

  .nav__brand:hover .nav__name {
    color: var(--c-pink-deep);
  }

  /* ---- Desktop links ---- */
  .nav__links {
    display: none;
    align-items: center;
    gap: var(--sp-6);
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__link {
    font-family: var(--ff-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--c-ink);
  }

  .nav__link[aria-current='page'] {
    color: var(--c-pink-deep);
  }

  .nav__cta {
    font-family: var(--ff-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--c-ink);
    background: var(--c-yellow);
    border: var(--line-thick) solid var(--c-ink);
    border-radius: var(--r-xs);
    padding: 0.6rem 1.1rem;
    box-shadow: 3px 3px 0 var(--c-ink);
    transition:
      transform var(--t-fast) var(--ease),
      box-shadow var(--t-fast) var(--ease);
  }

  .nav__cta:hover,
  .nav__cta:focus-visible {
    transform: translate(calc(-2px * var(--motion)), calc(-2px * var(--motion)));
    box-shadow: 5px 5px 0 var(--c-ink);
  }

  /* ---- Toggle ---- */
  .nav__toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.5rem;
    border: var(--line) solid var(--c-ink);
    border-radius: var(--r-xs);
  }

  .nav__bars {
    display: grid;
    gap: 5px;
    width: 20px;
  }

  .nav__bars i {
    display: block;
    height: 2px;
    background: var(--c-ink);
    transition: transform var(--t-fast) var(--ease);
  }

  .nav__toggle[aria-expanded='true'] .nav__bars i:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .nav__toggle[aria-expanded='true'] .nav__bars i:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* ---- Mobile panel ---- */
  .nav__panel {
    border-top: var(--line) solid var(--c-rule);
    background: var(--c-paper);
    padding: var(--sp-5) var(--gutter) var(--sp-7);
  }

  .nav__panel[hidden] {
    display: none;
  }

  .nav__panel-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__panel-list li + li {
    border-top: var(--line) solid var(--c-rule);
  }

  .nav__panel-list a {
    display: block;
    padding: var(--sp-4) 0;
    font-family: var(--ff-display);
    font-variation-settings: var(--wonk-on);
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--c-ink);
  }

  .nav__panel-list a[aria-current='page'] {
    color: var(--c-pink-deep);
  }

  .nav__panel-cta {
    color: var(--c-pink-deep) !important;
  }

  .nav__panel-note {
    margin-top: var(--sp-5);
  }

  @media (min-width: 56rem) {
    .nav__links {
      display: flex;
    }

    .nav__toggle,
    .nav__panel {
      display: none !important;
    }
  }
</style>

<style is:global>
  /* Stop the page scrolling behind the open mobile menu. */
  html.nav-open,
  html.nav-open body {
    overflow: hidden;
  }
</style>
