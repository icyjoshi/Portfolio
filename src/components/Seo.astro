---
/**
 * Everything that goes in <head>: titles, description, canonical,
 * Open Graph, Twitter/X cards and JSON-LD.
 *
 * Pages pass a title and description; sensible defaults come from
 * src/data/site.ts.
 */
import { site } from '@data/site';
import { asset } from '@lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Path to an OG image in /public. Falls back to the site default. */
  image?: string;
  imageAlt?: string;
  /** 'article' for case studies, lab posts and writing. */
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image = site.ogImage,
  imageAlt = site.ogImageAlt,
  type = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;

const pageTitle = title
  ? site.titleTemplate.replace('%s', title)
  : site.defaultTitle;

/* Astro.site comes from `site` in astro.config.mjs. Absolute URLs are
   required for OG tags — relative ones are ignored by most scrapers. */
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImageUrl = new URL(asset(image), Astro.site ?? Astro.url.origin);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  url: canonical.origin,
  description: site.description,
  knowsAbout: [
    'Brand strategy',
    'Campaign strategy',
    'Content strategy',
    'SEO',
    'Marketing analytics',
    'Community management',
  ],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={ogImageUrl.href} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
{
  publishedTime && (
    <meta
      property="article:published_time"
      content={publishedTime.toISOString()}
    />
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl.href} />
<meta name="twitter:image:alt" content={imageAlt} />

<meta name="author" content={site.name} />
<meta name="theme-color" content="#17152b" />

<link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
<link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
<link rel="sitemap" href={asset('/sitemap-index.xml')} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
