---
/**
 * The page shell. Every page on the site renders through this.
 *
 * Fonts are self-hosted (no Google Fonts request), latin subset only:
 *   Fraunces  wonk  ~36 KB  — display
 *   Archivo   wght  ~34 KB  — body
 *   Space Mono 400/700      — labels and annotations
 */
import '@fontsource-variable/fraunces/wonk.css';
import '@fontsource-variable/archivo/wght.css';
import '@fontsource/space-mono/latin-400.css';
import '@fontsource/space-mono/latin-700.css';

import '../styles/tokens.css';
import '../styles/global.css';

import Seo from '@components/Seo.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
  /** Adds a class to <body> for page-specific styling hooks. */
  bodyClass?: string;
}

const { bodyClass = '', ...seo } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Seo {...seo} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      /* Scroll reveal.
         Content is visible by default; the .js-reveal class is only
         added once this script runs, so nothing is ever hidden from
         someone with JS blocked. IntersectionObserver, no library. */
      const prefersReduced = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;

      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if (!prefersReduced && targets.length && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('js-reveal');

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.06 },
        );

        targets.forEach((el, index) => {
          /* Stagger only within a group, and cap it — a long list
             should not take four seconds to finish appearing. */
          const group = el.dataset.revealGroup;
          if (group) {
            const delay = Math.min(index % 6, 5) * 70;
            el.style.setProperty('--reveal-delay', `${delay}ms`);
          }
          observer.observe(el);
        });
      }
    </script>

    <style is:global>
      /* Layout skeleton: footer sits at the bottom on short pages. */
      body {
        display: flex;
        flex-direction: column;
      }

      main {
        flex: 1 0 auto;
      }

      main:focus {
        outline: none;
      }
    </style>
  </body>
</html>
